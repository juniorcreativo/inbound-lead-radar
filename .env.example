# --- Database (Neon Postgres) ---
# Get these from neon.tech after creating a project + database
DATABASE_URL=            # pooled connection string
DIRECT_URL=               # direct (non-pooled) connection string, used for migrations

# --- Reddit API (script app, client_credentials grant) ---
# Create a "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=       # e.g. "web:motioncut-inbound-lead-radar:v1.0 (by /u/yourredditusername)"

# --- Gemini API ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_CLASSIFY=gemini-flash-latest
GEMINI_MODEL_DRAFT=gemini-flash-latest

# --- Auth ---
ADMIN_PASSWORD=          # password to log into the dashboard
SESSION_SECRET=          # random 32+ byte string, e.g. `openssl rand -hex 32`
CRON_SECRET=             # random string shared with the GitHub Actions secret
